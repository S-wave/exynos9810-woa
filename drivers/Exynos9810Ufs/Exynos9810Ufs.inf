[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=10/28/2026,9.0.0.2
CatalogFile=Exynos9810Ufs.cat
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Models,NTARM64.10.0...19041

[Models.NTARM64.10.0...19041]
%DeviceDesc%=Exynos9810Ufs_Install,ACPI\EXYN9810

[ControlFlags]
ExcludeFromSelect=*

[Exynos9810Ufs_Install.NT]
CopyFiles=DriverCopy

[Exynos9810Ufs_Install.NT.Services]
AddService=Exynos9810Ufs,0x00000002,Exynos9810Ufs_Service,Miniport_EventLog

[Exynos9810Ufs_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=0
ErrorControl=1
ServiceBinary=%13%\Exynos9810Ufs.sys
LoadOrderGroup=SCSI Miniport
AddReg=BusTypeScsi

[DriverCopy]
Exynos9810Ufs.sys

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
Exynos9810Ufs.sys=1

[DestinationDirs]
DefaultDestDir=13
DriverCopy=13

[BusTypeScsi]
HKR,"Parameters","BusType",0x00010001,1

[Miniport_EventLog]
AddReg=Miniport_EventLog_AddReg

[Miniport_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,0x00010001,7

[Strings]
ProviderName="Galaxy S9+ Windows Project"
ManufacturerName="Samsung Electronics"
DeviceDesc="Samsung Exynos9810 UFS Host Controller"
ServiceDesc="Samsung Exynos9810 UFS Storport Miniport"
DiskDesc="Exynos9810 UFS one-shot clean recovery package"
